@startuml
!theme crt-amber
class Main [[java:Game.Main]] {
	+{static} main(args: String[]): void
}
class GameApp [[java:Game.GameApp]] {
	-frame: JFrame
	+GameApp()
	+show(): void
}
class LevelHandler {
}
GameApp --> "1" LevelHandler : panel
class Collectible [[java:Game.Collectible]] {
	-sprite: BufferedImage
	-spriteLoaded: boolean
	-collected: boolean
	+Collectible(X: int, Y: int)
	+draw(g2: Graphics2D): void
	+setCollected(b: boolean): void
	+getCollected(): boolean
}
class Collidable {
}
Collidable <|-- Collectible
class Collidable [[java:Game.Collidable]] {
	#X: int
	#Y: int
	#Vx: int
	#Vy: int
	#lastVx: int
	#startX: int
	#startY: int
	+boundingBox: Rectangle
	#scale: int
	+Collidable(X: int, Y: int, scale: int)
	+Collidable(X: int, Y: int, width: int, height: int)
	+getX(): int
	+getY(): int
	+getVx(): int
	+getVy(): int
	+setX(X: int): void
	+setY(Y: int): void
	+setVx(speed: int): void
	+setVy(V: int): void
	+move(): void
	+collide(newObject: Collidable): boolean
	+draw(g2: Graphics2D): void
	+getStartX(): int
	+getStartY(): int
}
class Level [[java:Game.Level]] {
	-{static} serialVersionUID: long
	+level: int
	+{static} WIDTH: int
	+{static} HEIGHT: int
	+BG: Color
	+Level()
	+Level(levelSet: ArrayList<Collidable>)
	#paintComponent(g: Graphics): void
	+moveAll(): void
	+collide(): void
	+movePlayer(velocityX: int): void
	+jumpPlayer(accelerationY: int): void
	+collect(): void
	+checkBounds(): void
	+setLevel(levelSet: ArrayList<Collidable>): void
}
